# Redis 缓存（可选，不配置也能正常运行，只是不缓存）
# 推荐使用 Vercel 市场的 Upstash Redis，集成后会自动注入这两个变量
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 如果用的是 Vercel KV，则改为下面两个变量（代码同样支持）
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 缓存键前缀：多个环境共用同一个 Redis 库时用来隔离（默认 blog）
REDIS_KEY_PREFIX=blog

# 单条 Redis 命令超时（毫秒，默认 1200）
REDIS_TIMEOUT_MS=1200

# 设为 true 可临时关闭全部缓存（排障用）
CACHE_DISABLED=false
